# Supabase Project Credentials (คัดลอกจาก Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (ขอรับฟรีได้ที่ https://aistudio.google.com/app/apikey)
# หรือสามารถกรอกผ่านหน้าเว็บที่ปุ่ม "AI Gemini" บนเมนูด้านบนได้โดยตรง
VITE_GEMINI_API_KEY=your-gemini-api-key

