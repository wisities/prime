# Supabase Project Credentials (คัดลอกจาก Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (ขอรับฟรีได้ที่ https://aistudio.google.com/app/apikey)
# หรือสามารถกรอกผ่านหน้าเว็บที่ปุ่ม "AI Gemini" บนเมนูด้านบนได้โดยตรง
VITE_GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# Google Cloud Service Account (สำหรับบันทึกข้อเสนอขึ้น Google Sheets และ Google Drive)
# ==============================================================================
# อีเมลของ Service Account จาก Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=sync-service@your-project-id.iam.gserviceaccount.com

# Private Key จากไฟล์ JSON (รวมขึ้นต้น -----BEGIN PRIVATE KEY----- และลงท้าย -----END PRIVATE KEY-----)
# หมายเหตุ: หากใส่ใน Vercel ให้วางแบบมี \n หรือครอบด้วยเครื่องหมายคำพูด
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID ของโฟลเดอร์หลักใน Google Drive (ดึงจาก URL ของโฟลเดอร์หลัง /folders/...)
# ตัวอย่าง: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-parent-folder-id

# ID ของ Google Sheet แดชบอร์ดสรุปโครงการหลัก (ดึงจาก URL ของ Sheet หลัง /d/...)
# ตัวอย่าง: https://docs.google.com/spreadsheets/d/1xYzAbCdEfGhIjKlMnOpQrStUvWxYz/edit
GOOGLE_MASTER_SHEET_ID=your-google-master-sheet-id

# (ตัวเลือกเสริม) หากต้องการใช้ Google Apps Script Web App เป็นทางเลือกสำรอง
VITE_GOOGLE_APPS_SCRIPT_URL=
